[sub_resource type="GDScript" id="GDScript_0pbsb"]
script/source = "extends MeshInstance3D

func _physics_process(delta: float) -> void:
	$Tail/TailHorizontal/Elevator.rotation.x = $\"../TailHorizontal/Elevator\".rotation.x
	$Tail/Rudder.rotation.y = -$\"../TailVertical/Rudder\".rotation.x
	$Wing/AileronR.rotation.x = $\"../Wing/Wing2/Aileron\".rotation.x + deg_to_rad(13.9)
	
	#the mirrored wing might not show up until after this runs once
	if get_node_or_null(\"../Wing/Wing2Mirror/Aileron\"):
		$Wing/AileronL.rotation.x = $\"../Wing/Wing2Mirror/Aileron\".rotation.x + deg_to_rad(13.9)
"

